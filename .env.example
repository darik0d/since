# Context.dev REST API key (Authorization: Bearer ...)
CONTEXT_API_KEY=
CONTEXT_API_BASE=https://api.context.dev/v1

# Public base URL of this app (used as the monitor webhook target)
# e.g. https://203-0-113-10.sslip.io
PUBLIC_BASE_URL=http://localhost:3000

# LLM (maps "come back when..." to conditions, extracts claims; never decides a status)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Monitors: created only when PUBLIC_BASE_URL is https. Demo domains get a 10-min schedule (others 30).
DEMO_DOMAINS=nordwind.io,kallio.fi
MONITORS_DISABLED=false

# Domain Caddy serves on the VM (e.g. 203-0-113-10.sslip.io)
SITE_DOMAIN=

# Webhook signature check. Per-monitor secrets are stored in SQLite when Since creates
# the monitor. Extra secrets (comma-separated whsec_...) for monitors created elsewhere:
CONTEXT_WEBHOOK_SECRETS=
# "true" = reject unsigned/invalid webhooks with 401. During M0 keep false: everything is logged, flagged.
WEBHOOK_ENFORCE_SIGNATURE=false

# Postgres. Aiven: copy the Service URI (postgres://avnadmin:...@...aivencloud.com:PORT/defaultdb?sslmode=require)
# Local: postgres://postgres:postgres@localhost:5432/since
DATABASE_URL=
# Optional: Aiven project CA certificate (PEM, 
-escaped is fine) for full TLS verification
DATABASE_CA_CERT=

# Alerts (later milestones)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=   # optional: Settings → Detect chat stores it in the DB
SLACK_WEBHOOK_URL=
